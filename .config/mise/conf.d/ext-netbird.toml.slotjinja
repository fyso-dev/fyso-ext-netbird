# NetBird private access extension. The netbird client is a system service
# (it owns the WireGuard interface), so it is not pinned here.

[tasks."netbird:plan"]
description = "Show the NetBird DNS records this project's web addresses need"
run = "framework/scripts/run-ext.sh netbird -- node extensions/netbird/netbird.cjs plan"

[tasks."netbird:sync"]
description = "Create or update the NetBird DNS records of this project's web addresses"
run = "framework/scripts/run-ext.sh netbird -- node extensions/netbird/netbird.cjs apply"
